<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DriveManager.App.Views.ConfirmPopup"
        Width="520" Height="320"
        MinWidth="400" MinHeight="220"
        WindowStartupLocation="CenterOwner"
        RequestedThemeVariant="Dark"
        Background="#0D1117"
        Foreground="#E6EDF3"
        CanResize="True">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
            <Button Content="Cancel" Click="OnCancel" />
            <Button Content="OK" Click="OnOk" Classes="accent" FontWeight="SemiBold" />
        </StackPanel>
        <ScrollViewer>
            <SelectableTextBlock Name="MessageText" TextWrapping="Wrap" FontSize="13" />
        </ScrollViewer>
    </DockPanel>
</Window>
