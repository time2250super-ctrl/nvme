<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DriveManager.App.ViewModels"
        xmlns:models="using:DriveManager.Core.Models"
        xmlns:core="using:DriveManager.Core.Abstractions"
        xmlns:ai="using:DriveManager.Ai"
        xmlns:conv="using:DriveManager.App.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="620"
        x:Class="DriveManager.App.Views.MainWindow"
        x:DataType="vm:DashboardViewModel"
        Width="1040" Height="680"
        RequestedThemeVariant="Dark"
        Background="#0D1117"
        Foreground="#E6EDF3"
        Title="Drive Manager">

    <Window.Resources>
        <conv:HealthLevelToBrushConverter x:Key="HealthBrush" />
    </Window.Resources>

    <Design.DataContext>
        <vm:DashboardViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto" Margin="12">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
            <StackPanel Grid.Column="0">
                <TextBlock Text="Drive Manager" FontSize="22" FontWeight="Bold" />
                <TextBlock Text="Health, formatting and security for every disk on this PC"
                           Opacity="0.7" FontSize="13" />
            </StackPanel>
            <Button Grid.Column="1" Content="Rescan"
                    VerticalAlignment="Center"
                    Command="{Binding RefreshCommand}"
                    IsEnabled="{Binding !IsBusy}" />
        </Grid>

        <!-- Master / detail -->
        <Grid Grid.Row="1" ColumnDefinitions="320,*" >

            <!-- Disk list -->
            <Border Grid.Column="0" BorderBrush="#33808080" BorderThickness="1"
                    CornerRadius="6" Padding="4" Margin="0,0,10,0">
                <ListBox ItemsSource="{Binding Disks}"
                         SelectedItem="{Binding SelectedDisk}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:PhysicalDiskInfo" x:CompileBindings="False">
                            <StackPanel Margin="4,5">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding FriendlyName}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" Foreground="#E6EDF3" />
                                </Grid>
                                <TextBlock FontSize="12" Opacity="0.85" Foreground="#8B949E"
                                           Text="{Binding BusType}" />
                                <TextBlock FontSize="12" Opacity="0.85" Foreground="#8B949E"
                                           Text="{Binding SizeGb, StringFormat='{}{0} GB'}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Detail: compact identity + always-visible tool tabs -->
            <DockPanel Grid.Column="1">
                <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,8">
                    <StackPanel Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="{Binding SelectedDisk.FriendlyName, FallbackValue='No disk selected — Rescan or pick a disk'}"
                                       FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Classes="muted" FontSize="12">
                            <Run Text="Serial:" FontWeight="SemiBold" />
                            <Run Text="{Binding SelectedDisk.SerialNumber, FallbackValue='—'}" />
                            <Run Text="   " />
                            <Run Text="{Binding SelectedDisk.BusType}" />
                            <Run Text="   " />
                            <Run Text="{Binding SelectedDisk.SizeGb}" />
                            <Run Text=" GB" />
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                            <Button Content="Disk summary" Command="{Binding ShowDiskSummaryCommand}" />
                            <Button Content="Volumes / FS" Command="{Binding ShowFsSummaryCommand}" />
                            <Button Content="Health summary" Command="{Binding ShowHealthSummaryCommand}" />
                            <Button Content="History summary" Command="{Binding ShowHistorySummaryCommand}" />
                            <Button Content="Encryption summary" Command="{Binding ShowEncryptionSummaryCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TabControl>


                    <!-- ===== HEALTH TAB ===== -->
                    <TabItem Header="Health">
                        <ScrollViewer>
                            <StackPanel Spacing="12" Margin="0,8,4,0">

                    <Border Classes="card">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Drive Health" FontSize="15" FontWeight="Bold" />
                            <TextBlock Classes="muted" TextWrapping="Wrap"
                                       Text="Summaries open as popups so the tabs stay clear. Read health also pops the AI assessment." />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Read health" Classes="accent"
                                        Command="{Binding LoadHealthCommand}"
                                        CommandParameter="{Binding SelectedDisk}"
                                        IsEnabled="{Binding !IsBusy}" />
                                <Button Content="Open health summary" Command="{Binding ShowHealthSummaryCommand}" />
                                <Button Content="Open volume / FS summary" Command="{Binding ShowFsSummaryCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ===== HISTORY TAB ===== -->
                    <TabItem Header="History">
                        <ScrollViewer>
                            <StackPanel Spacing="12" Margin="0,8,4,0">

                    <!-- Health history / trend -->
                    <Border Classes="card"
                            IsVisible="{Binding SelectedHealth, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Health History &amp; Trend" FontSize="15" FontWeight="Bold" />
                            <Button Content="Open history summary" HorizontalAlignment="Left"
                                    Command="{Binding ShowHistorySummaryCommand}" />
                            <Grid ColumnDefinitions="140,90,70,*" Margin="0,4,0,0">
                                <TextBlock Grid.Column="0" Text="Captured" FontWeight="SemiBold" FontSize="12" />
                                <TextBlock Grid.Column="1" Text="Temp (C)" FontWeight="SemiBold" FontSize="12" />
                                <TextBlock Grid.Column="2" Text="Used %" FontWeight="SemiBold" FontSize="12" />
                                <TextBlock Grid.Column="3" Text="Status" FontWeight="SemiBold" FontSize="12" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding History}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:DriveHealthInfo">
                                        <Grid ColumnDefinitions="140,90,70,*">
                                            <TextBlock Grid.Column="0" Text="{Binding CapturedAt}" FontSize="12" />
                                            <TextBlock Grid.Column="1" Text="{Binding TemperatureCelsius}" FontSize="12" />
                                            <TextBlock Grid.Column="2" Text="{Binding PercentageUsed}" FontSize="12" />
                                            <TextBlock Grid.Column="3" Text="{Binding HealthStatus}" FontSize="12" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ===== TOOLS TAB ===== -->
                    <TabItem Header="Tools">
                        <ScrollViewer>
                            <StackPanel Spacing="12" Margin="0,8,4,0">

                    <!-- Drive tools (non-destructive) -->
                    <Border Classes="card">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Drive Tools (safe / non-destructive)" FontSize="15" FontWeight="Bold" />

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Volume:" VerticalAlignment="Center" FontWeight="SemiBold" />
                                <ComboBox MinWidth="260" ItemsSource="{Binding SelectedDisk.Volumes}"
                                          SelectedItem="{Binding SelectedVolume}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:VolumeInfo">
                                            <TextBlock>
                                                <Run Text="{Binding DriveLetter}" />
                                                <Run Text=": " />
                                                <Run Text="{Binding Label}" />
                                                <Run Text=" (" />
                                                <Run Text="{Binding FileSystem}" />
                                                <Run Text=")" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" Margin="0,4,0,0">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="New label:" VerticalAlignment="Center"
                                           FontWeight="SemiBold" Margin="0,0,8,4" />
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding NewLabel}" Margin="0,0,8,4" />
                                <Button Grid.Row="0" Grid.Column="2" Content="Preview rename" Margin="0,0,0,4"
                                        Command="{Binding PreviewRenameCommand}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="New letter:" VerticalAlignment="Center"
                                           FontWeight="SemiBold" Margin="0,0,8,0" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding NewDriveLetter}" MaxLength="1" Margin="0,0,8,0" />
                                <Button Grid.Row="1" Grid.Column="2" Content="Preview change letter"
                                        Command="{Binding PreviewChangeLetterCommand}" />
                            </Grid>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Preview remove letter" Command="{Binding PreviewRemoveLetterCommand}" />
                                <Button Content="Preview take offline" Command="{Binding PreviewOfflineCommand}" />
                                <Button Content="Preview bring online" Command="{Binding PreviewOnlineCommand}" />
                            </StackPanel>

                            <Border Background="#1A808080" CornerRadius="4" Padding="8" Margin="0,4,0,0"
                                    IsVisible="{Binding ToolsPreview, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{Binding ToolsPreview}" TextWrapping="Wrap" FontFamily="Consolas,monospace" FontSize="12" />
                                    <TextBlock Text="{Binding ConfirmationHint}" Foreground="#E3A008" FontWeight="SemiBold"
                                               IsVisible="{Binding ConfirmationHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    <TextBox Text="{Binding ConfirmationInput}" Watermark="Confirmation phrase (if required)"
                                             IsVisible="{Binding ConfirmationHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    <Button Content="Apply" HorizontalAlignment="Left"
                                            Command="{Binding ApplyPendingCommand}" IsEnabled="{Binding !IsBusy}" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{Binding ToolsStatus}" Opacity="0.8" FontSize="12" />
                        </StackPanel>
                    </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ===== SECURITY TAB ===== -->
                    <TabItem Header="Security">
                        <ScrollViewer>
                            <StackPanel Spacing="12" Margin="0,8,4,0">
                                <Border Classes="card">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Encryption (BitLocker)" Classes="h2" />
                                        <TextBlock Text="{Binding EncStatus}" TextWrapping="Wrap" />

                                        <Border Background="#1A2FB24C" CornerRadius="4" Padding="8"
                                                IsVisible="{Binding Security.RecoveryPassword, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="Recovery key (save this somewhere safe):" FontWeight="SemiBold" FontSize="12" />
                                                <SelectableTextBlock Text="{Binding Security.RecoveryPassword}"
                                                                     FontFamily="Consolas,monospace" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>

                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="Enable encryption" Command="{Binding PreviewEnableEncryptionCommand}" />
                                            <Button Content="Disable encryption" Command="{Binding PreviewDisableEncryptionCommand}" />
                                        </StackPanel>

                                        <Border Background="#1A808080" CornerRadius="4" Padding="10" Margin="0,4,0,0"
                                                IsVisible="{Binding EncPreview, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="{Binding EncPreview}" TextWrapping="Wrap"
                                                           FontFamily="Consolas,monospace" FontSize="12" />
                                                <TextBlock Text="{Binding EncConfirmHint}" Foreground="#E3A008" FontWeight="Bold"
                                                           TextWrapping="Wrap" />
                                                <TextBox Text="{Binding EncConfirmation}" Watermark="Type the confirmation phrase" />
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Button Content="Apply" Classes="accent"
                                                            Command="{Binding ExecuteEncryptionCommand}" IsEnabled="{Binding !IsBusy}" />
                                                    <Button Content="Cancel" Command="{Binding CancelEncryptionCommand}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Permissions">
                        <ScrollViewer>
                            <StackPanel Spacing="12" Margin="0,8,4,0">
                                <Border Classes="card">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Permission manager" Classes="h2" />
                                        <TextBlock Text="{Binding PermissionSummary}" TextWrapping="Wrap" />
                                        <TextBlock Classes="muted" TextWrapping="Wrap"
                                                   Text="Built for Windows 11 x64. Apply enables Administrator rights, StorNVMe/in-box NVMe driver checks, volume privileges, and BitLocker cmdlets. No extra vendor NVMe driver is required — Windows 11's Standard NVM Express Controller is the correct stack." />
                                        <Button Content="Apply / re-check permissions" Classes="accent" HorizontalAlignment="Left"
                                                Command="{Binding ApplyPermissionsCommand}" IsEnabled="{Binding !IsBusy}" />
                                        <ItemsControl ItemsSource="{Binding PermissionItems}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="core:PermissionItem">
                                                    <Grid ColumnDefinitions="160,70,*" Margin="0,3">
                                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Verdict}" FontWeight="Bold" />
                                                        <TextBlock Grid.Column="2" Text="{Binding Detail}" Classes="muted" TextWrapping="Wrap" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ===== AI TAB ===== -->
                    <TabItem Header="AI">
                        <ScrollViewer>
                            <StackPanel Spacing="12" Margin="0,8,4,0">
                                <Border Classes="card">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Local AI model" Classes="h2" />
                                        <TextBlock Text="{Binding ModelStatus}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding ModelsDirectory}" Classes="muted" FontSize="11"
                                                   TextWrapping="Wrap" />

                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <ComboBox MinWidth="260" ItemsSource="{Binding Models}"
                                                      SelectedItem="{Binding SelectedModel}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="ai:AiModelInfo">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Text="{Binding Name}" />
                                                            <TextBlock Text="{Binding SizeDisplay}" Classes="muted" />
                                                            <TextBlock Text="(active)" Foreground="#2FB24C"
                                                                       IsVisible="{Binding IsActive}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <Button Content="Set active" Command="{Binding SetActiveModelCommand}" />
                                            <Button Content="Refresh" Command="{Binding RefreshModelsCommand}" />
                                            <Button Content="Delete" Command="{Binding DeleteModelCommand}" />
                                        </StackPanel>

                                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding ModelProgress}"
                                                     Height="6" IsVisible="{Binding IsModelBusy}" />
                                    </StackPanel>
                                </Border>

                                <Border Classes="card">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Download a model" Classes="h2" />
                                        <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"
                                                   Text="Paste a direct https URL to a .gguf file (e.g. a quantized model under ~4 GB)." />
                                        <TextBox Text="{Binding ModelDownloadUrl}"
                                                 Watermark="https://.../model.Q4_K_M.gguf" />
                                        <Button Content="Download" Classes="accent" HorizontalAlignment="Left"
                                                Command="{Binding DownloadModelCommand}" IsEnabled="{Binding !IsModelBusy}" />
                                    </StackPanel>
                                </Border>

                                <Border Classes="card">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Import a model" Classes="h2" />
                                        <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"
                                                   Text="Full path to a local .gguf file to copy into the portable models folder." />
                                        <TextBox Text="{Binding ModelImportPath}"
                                                 Watermark="C:\path\to\model.gguf" />
                                        <Button Content="Import" HorizontalAlignment="Left"
                                                Command="{Binding ImportModelCommand}" IsEnabled="{Binding !IsModelBusy}" />
                                    </StackPanel>
                                </Border>

                                <Border Classes="card">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Ask the assistant" Classes="h2" />
                                        <TextBox Text="{Binding ChatPrompt}" AcceptsReturn="True" MinHeight="48"
                                                 Watermark="Ask about this drive's health, partitions, encryption..." />
                                        <Button Content="Ask" Classes="accent" HorizontalAlignment="Left"
                                                Command="{Binding AskChatCommand}" IsEnabled="{Binding !IsChatBusy}" />
                                        <Border Background="#1A808080" CornerRadius="4" Padding="10"
                                                IsVisible="{Binding ChatOutput, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                            <SelectableTextBlock Text="{Binding ChatOutput}" TextWrapping="Wrap" FontSize="13" />
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ===== DANGER ZONE TAB ===== -->
                    <TabItem>
                        <TabItem.Header>
                            <TextBlock Text="Danger Zone" Foreground="#E51A1A" FontWeight="Bold" />
                        </TabItem.Header>
                        <ScrollViewer>
                            <StackPanel Spacing="12" Margin="0,8,4,0">
                                <Border BorderBrush="#E51A1A" BorderThickness="1" CornerRadius="6" Padding="12">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Destructive Tools" FontSize="15" FontWeight="Bold" Foreground="#E51A1A" />
                                        <TextBlock TextWrapping="Wrap" Opacity="0.85" FontSize="12"
                                                   Text="These operations erase data irreversibly. System/boot disks are always blocked. Nothing runs until you type the exact confirmation phrase and press Execute." />

                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="File system:" VerticalAlignment="Center" FontWeight="SemiBold" />
                                            <ComboBox MinWidth="120" ItemsSource="{Binding FileSystemOptions}"
                                                      SelectedItem="{Binding SelectedFileSystem}" />
                                            <TextBlock Text="Label:" VerticalAlignment="Center" FontWeight="SemiBold" />
                                            <TextBox Width="160" Text="{Binding FormatLabel}" />
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="Preview quick format (selected volume)"
                                                    Command="{Binding PreviewQuickFormatCommand}" />
                                            <Button Content="Preview wipe + repartition (whole disk)"
                                                    Command="{Binding PreviewRepartitionCommand}" />
                                        </StackPanel>
                                        <Button Content="Preview secure erase (whole disk)" HorizontalAlignment="Left"
                                                Command="{Binding PreviewSecureEraseCommand}" />

                                        <Border Background="#22E51A1A" BorderBrush="#E51A1A" BorderThickness="1"
                                                CornerRadius="4" Padding="10" Margin="0,4,0,0"
                                                IsVisible="{Binding DangerPreview, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="{Binding DangerPreview}" TextWrapping="Wrap"
                                                           FontFamily="Consolas,monospace" FontSize="12" />
                                                <TextBlock Text="{Binding DangerConfirmHint}" Foreground="#E51A1A" FontWeight="Bold"
                                                           TextWrapping="Wrap" />
                                                <TextBox Text="{Binding DangerConfirmation}"
                                                         Watermark="Type the exact confirmation phrase here" />
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Button Content="EXECUTE" Foreground="White" Background="#E51A1A"
                                                            FontWeight="Bold"
                                                            Command="{Binding ExecuteDestructiveCommand}"
                                                            IsEnabled="{Binding !IsBusy}" />
                                                    <Button Content="Cancel" Command="{Binding CancelDestructiveCommand}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Text="{Binding DangerStatus}" TextWrapping="Wrap" Opacity="0.9" FontSize="12" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                </TabControl>
            </DockPanel>
        </Grid>

        <!-- Legend (lower-left) + status bar -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto,*" Margin="0,10,0,0">
            <Border Grid.Column="0" Background="#22808080" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="Legend:" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Border Width="12" Height="12" CornerRadius="3" Background="#2FB24C" VerticalAlignment="Center" />
                        <TextBlock Text="Free space" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Border Width="12" Height="12" CornerRadius="3" Background="#2F81F7" VerticalAlignment="Center" />
                        <TextBlock Text="Healthy" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Border Width="12" Height="12" CornerRadius="3" Background="#E3A008" VerticalAlignment="Center" />
                        <TextBlock Text="Watch" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Border Width="12" Height="12" CornerRadius="3" Background="#F05A28" VerticalAlignment="Center" />
                        <TextBlock Text="Warning" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Border Width="12" Height="12" CornerRadius="3" Background="#E51A1A" VerticalAlignment="Center" />
                        <TextBlock Text="Critical" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="#22808080" CornerRadius="4" Padding="8,4">
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" />
            </Border>
        </Grid>
    </Grid>
</Window>
