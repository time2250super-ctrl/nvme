<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <AssemblyName>DriveManager.Setup</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="payload\DriveManager.App.zip" LogicalName="DriveManager.Payload.App.zip" Condition="Exists('payload\DriveManager.App.zip')" />
    <ProjectReference Include="..\DriveManager.Core\DriveManager.Core.csproj" />
    <ProjectReference Include="..\DriveManager.Platform.Windows\DriveManager.Platform.Windows.csproj" />
  </ItemGroup>
</Project>
